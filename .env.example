# Copy to .env for local overrides. Every value below has a working local default,
# so `docker compose up` runs without a .env file. Never commit a real .env.

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# The one browser origin of this environment (no path). Non-GET API requests must send it as
# `Origin` (CSRF check) and the session cookie is `Secure` only when it is https.
# Optional locally (default http://localhost:3000); REQUIRED when NODE_ENV=production.
# Vite dev server: http://localhost:5173
APP_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=7
# Sign-up and log-in attempts per IP per 15 minutes (shared bucket). Raise it only for
# test/E2E runs that create many users; keep 10 elsewhere.
AUTH_RATE_LIMIT_MAX=10
# Public testimonial submissions per IP per 10 minutes. Raise it only for test/E2E runs.
SUBMISSION_RATE_LIMIT_MAX=5
# Public Wall reads per IP per minute.
WALL_RATE_LIMIT_MAX=120
# Number of reverse proxies in front of the API (0-10, default 0 = trust nothing). Must equal the real
# number: too low and every visitor shares the proxy's rate-limit bucket, too high and clients can
# spoof their IP. Never `true` or `*`; those are rejected at startup.
TRUST_PROXY_HOPS=0

# Used by the API when it runs on the host (outside Docker).
# Inside Docker Compose the API connects to the `db` service on db:5432 instead.
DATABASE_URL=postgresql://testimonial:testimonial_dev@localhost:54320/testimonial

# --- Docker Compose: host ports (bound to 127.0.0.1) ---
# The database ports default away from 5432/5433 so they do not clash with a local Postgres.
API_HOST_PORT=3000
DB_HOST_PORT=54320
DB_TEST_HOST_PORT=54330

# --- Docker Compose: development database (`db`) ---
POSTGRES_USER=testimonial
POSTGRES_PASSWORD=testimonial_dev
POSTGRES_DB=testimonial

# --- Docker Compose: test database (`db-test`, data in tmpfs) ---
TEST_DATABASE_URL=postgresql://testimonial:testimonial_test@localhost:54330/testimonial_test
