# Copy to .env for local overrides. Every value below has a working local default,
# so `docker compose up` runs without a .env file. Never commit a real .env.

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Used by the API when it runs on the host (outside Docker).
# Inside Docker Compose the API connects to the `db` service on db:5432 instead.
DATABASE_URL=postgresql://testimonial:testimonial_dev@localhost:54320/testimonial

# --- Docker Compose: host ports (bound to 127.0.0.1) ---
# The database ports default away from 5432/5433 so they do not clash with a local Postgres.
API_HOST_PORT=3000
DB_HOST_PORT=54320
DB_TEST_HOST_PORT=54330

# --- Docker Compose: development database (`db`) ---
POSTGRES_USER=testimonial
POSTGRES_PASSWORD=testimonial_dev
POSTGRES_DB=testimonial

# --- Docker Compose: test database (`db-test`, data in tmpfs) ---
TEST_DATABASE_URL=postgresql://testimonial:testimonial_test@localhost:54330/testimonial_test
