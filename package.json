{
  "name": "testimonial-saas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm -F @testimonial-saas/widget size",
    "verify": "pnpm db:test:up && pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm size",
    "test:hooks": "node --test .claude/hooks/guard-git-add.test.mjs",
    "test:api": "pnpm -F @testimonial-saas/api test",
    "test:e2e": "playwright test",
    "db:test:up": "docker compose up -d --wait db-test",
    "toolchain:check": "pnpm -F @testimonial-saas/api toolchain:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
