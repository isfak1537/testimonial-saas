{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--headless",
        "--viewport-size=1280x800",
        "--allowed-origins=http://localhost:3000;http://localhost:8000",
        "--output-dir=docs/screenshots"
      ]
    }
  }
}
